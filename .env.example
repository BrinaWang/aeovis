# Copy this to .env for local development
# Configuration file path (optional; defaults to config.yaml)
CONFIG_PATH=config.yaml

# =============================================================================
# API Keys for AI Providers
# Set one or more of these to enable the corresponding engine
# =============================================================================

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API
OPENAI_API_KEY=sk-...

# Google Gemini API
GOOGLE_API_KEY=...

# Grok API (xAI)
GROK_API_KEY=...

# Perplexity API
PERPLEXITY_API_KEY=pplx-...

# =============================================================================
# Optional: Override configuration file paths
# =============================================================================

# Question dataset JSON path (default: question.json)
# QUESTION_PATH=question.json

# SQLite database output path (default: data/eval_runs.db)
# OUTPUT_DB_PATH=data/eval_runs.db

# =============================================================================
# Optional: Development settings
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Development mode
# APP_ENV=development
